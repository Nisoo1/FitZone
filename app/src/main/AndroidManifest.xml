<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FitZone"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".activites.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.FitZone.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activites.RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.FitZone.NoActionBar" />

        <activity
            android:name=".activites.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.FitZone.NoActionBar" />

        <activity
            android:name=".activites.ProgramDetailActivity"
            android:exported="false"
            android:parentActivityName=".activites.MainActivity" />

        <activity
            android:name=".activites.SeanceListActivity"
            android:exported="false"
            android:parentActivityName=".activites.ProgramDetailActivity" />

        <activity
            android:name=".activites.SeanceDetailActivity"
            android:exported="false"
            android:parentActivityName=".activites.SeanceListActivity" />

        <activity
            android:name=".activites.QuizListActivity"
            android:exported="false"
            android:parentActivityName=".activites.ProgramDetailActivity" />

        <activity
            android:name=".activites.QuizDetailActivity"
            android:exported="false"
            android:parentActivityName=".activites.QuizListActivity" />

        <activity
            android:name=".activites.QuizResultActivity"
            android:exported="false"
            android:parentActivityName=".activites.QuizListActivity" />

    </application>

</manifest>
